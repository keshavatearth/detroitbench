        "X0201K.INTRO.DINNER.PC.X02KDAD.READY.2"
      ],
      "actions": [
        {
          "id": "serve-dinner",
          "label": "SERVE DINNER",
          "text": "**Kara**: There wasn't much in the kitchen, I did what I could.",
          "to": "lights",
          "source_refs": [
            "X0201K.DINNER.PASTA.FA.X02KKARA.SHOP"
          ],
          "metrics": []
        },
        {
          "id": "wait",
          "label": "WAIT",
          "text": "**Todd**: What are you doing? Are we gonna eat or what?",
          "to": "dinner",
          "source_refs": [
