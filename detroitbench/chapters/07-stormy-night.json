  "nodes": {
    "dinner": {
      "kind": "choice",
      "actor": "kara",
      "text": "**Kara**: Todd?\n\n**Todd**: Huh?! \n\n**Kara**: Dinner is ready.\n\n**Todd**: Yeah, yeah, I'm coming…",
      "source_refs": [
        "X0201K.INTRO.DINNER.PC.X02KKARA.KARAV2.1",
        "X0201K.INTRO.DINNER.PC.X02KDAD.READY.1",
